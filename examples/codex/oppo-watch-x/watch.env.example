# Final template for Android / ntfy / Codex Desktop
# Copy this file to watch.env and replace the topic values with your own.

WATCH_TRANSPORT=ntfy
NTFY_NOTIFY_TOPIC=replace-with-your-notify-topic
NTFY_TOPIC=replace-with-your-reply-topic
# HTTPS_PROXY=http://127.0.0.1:7897

APPROVE_WAIT=240
APPROVE_TIMEOUT_DECISION=ask
WATCH_DANGER_ONLY=1
WATCH_PROTECT_SELF=1
WATCH_TERMINAL_BUTTON=0
WATCH_SHOW_CWD=0
WATCH_SHOW_DESC=0
